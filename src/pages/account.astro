---
import Base from '../layouts/Base.astro';
import {supportEmail} from '../lib/paid-product.mjs';
---
<Base title="Deal Lab account" description="Sign-in, subscription management and monthly usage for Acquisition Companion Deal Lab." type="About" noindex analytics={false}>
 <article class="narrow" data-paid-page><header class="page-header"><p class="eyebrow">Deal Lab</p><h1>Your account</h1></header>
 <p class="notice" data-paid-status role="status" aria-live="polite">Account sign-in is not currently available. The free course remains accessible without an account.</p>
 <form data-signin-form hidden><label for="account-email">Email address</label><input id="account-email" type="email" autocomplete="email" maxlength="254" required/><p class="small muted spaced">A sign-in link will open in this browser. Your email is used for account access and billing, not AI conversation storage.</p><button class="button spaced" type="submit">Email a sign-in link</button></form>
 <button class="button" data-confirm-signin hidden>Confirm sign-in</button>
 <section data-account-details hidden><h2>Subscription and usage</h2><p data-subscription-summary></p><p data-entitled-usage hidden><span data-usage-summary></span></p><p class="small spaced" data-beta-request hidden>The initial paid beta is invite-only for U.S. customers. <a href={`mailto:${supportEmail}`}>Request beta access</a>. Approval alone does not grant Deal Lab access.</p><p class="small spaced" data-beta-approved hidden>Checkout approval is active. Choose a plan on the <a href="/pricing/">pricing page</a>; approval alone does not grant Deal Lab access.</p><div class="actions spaced"><a href="/pricing/" data-subscription-options hidden>View subscription options</a><button class="button secondary" data-billing-portal hidden>Manage billing</button><button class="button secondary" data-logout>Sign out</button></div></section>
 <div class="actions spaced"><a href="/ai/">Back to AI Deal Lab →</a><a href="/course/">Read the free course →</a></div>
 <p class="small spaced">Need help with account access, billing or cancellation? <a href={`mailto:${supportEmail}`}>{supportEmail}</a>.</p>
 <noscript><p class="notice spaced">Account actions require JavaScript. The course remains readable without it.</p></noscript>
 </article><script src="../scripts/paid-account.ts"></script>
</Base>

<style>form{max-width:28rem}label{display:block;margin-bottom:.5rem}input{width:100%;padding:.75rem;border:1px solid var(--line);border-radius:3px;background:var(--surface);color:var(--ink)}input:focus-visible{outline:2px solid var(--teal);outline-offset:3px}</style>
