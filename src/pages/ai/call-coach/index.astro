---
import Base from '../../../layouts/Base.astro';
import {CALL_AREAS,COVERAGE_STATUSES} from '../../../lib/seller-call-coach.mjs';
import '../../../styles/call-coach.css';
---
<Base title="Seller Call Coach" description="Know what to ask next on an introductory seller call. An Acquisition Companion Deal Lab feature." type="AI Deal Lab" workspace analytics={false}>
 <div class="call-coach" data-call-coach>
  <header class="coach-topbar">
   <a class="coach-brand" href="/ai/"><span class="brand-mark" aria-hidden="true">AC</span><span>AI Deal Lab <span aria-hidden="true">/</span> Seller Call Coach</span></a>
   <nav aria-label="Call workspace"><a href="/ai/">Other Deal Lab modes</a><a href="/account/">Account &amp; usage</a><button type="button" class="button secondary" data-clear-call>Clear call</button></nav>
  </header>
  <header class="coach-intro"><div><p class="eyebrow">Introductory seller calls</p><h1>Know what to ask next.</h1></div><span class="coach-session-label">Session only · No audio recording</span></header>
  <p class="coach-boundary"><strong>Use short summaries, not confidential transcripts.</strong> Do not enter confidential, proprietary, personal, or non-public deal information. Use fictional or public information only. <a href="#call-privacy">How notes are handled</a>.</p>
  <div class="coach-access" role="status" aria-live="polite"><span data-coach-status>Checking paid access…</span> <span data-coach-access-links hidden><a href="/account/">Sign in / account</a> · <a href="/pricing/">View plans</a></span></div>
  <div class="coach-grid" data-pagefind-ignore>
   <section class="coach-panel coach-notes" aria-labelledby="notes-heading">
    <div class="coach-panel-heading"><h2 id="notes-heading"><label for="call-notes">Live notes</label></h2><span data-note-count>0 / 4,000</span></div>
    <p id="notes-help" class="small">Type short, non-confidential facts while you talk. Nothing is sent until you ask for coaching.</p>
    <textarea id="call-notes" rows="8" maxlength="4000" autocomplete="off" spellcheck="false" aria-describedby="notes-help" placeholder="Owner says $600k profit.&#10;Largest customer about 30%.&#10;Owner handles quoting and top clients.&#10;Wants to retire next year."></textarea>
    <div class="coach-controls"><button type="button" class="button" data-ask-next disabled>What should I ask next?</button><button type="button" class="button secondary" data-review-call disabled>Review this call</button></div>
    <p class="coach-meter small">Each action uses one request from your existing Deal Lab allowance. No extra subscription.</p>
    <p class="coach-error" data-coach-error role="alert" hidden></p>
   </section>
   <section class="coach-panel coach-answer" aria-labelledby="next-heading" aria-busy="false" data-answer-panel>
    <p class="eyebrow">Seller Call Coach</p><h2 id="next-heading">Next question</h2>
    <div aria-live="polite" aria-atomic="true"><p class="coach-question" data-next-question>Add a few notes, then ask for your next question.</p><p class="small coach-freshness" data-freshness hidden></p></div>
    <div data-question-detail hidden><h3>Why it matters</h3><p data-why></p><div data-watch-panel hidden><h3>Watch for</h3><p data-watch></p></div></div>
    <p class="coach-answer-note small">A prompt for the conversation. Seller statements still need independent verification.</p>
    <details class="coach-sources" data-sources-panel hidden><summary>Course concepts behind this response</summary><ul data-call-sources></ul></details>
   </section>
   <section class="coach-panel coach-coverage" aria-labelledby="goals-heading">
    <div class="coach-panel-heading"><div><p class="eyebrow">Call goals &amp; coverage</p><h2 id="goals-heading">What have you learned?</h2></div><span class="small" data-coverage-count>0 / 9 clear</span></div>
    <p class="small">Guide the conversation, without following a rigid script. You can change any status; your selections take priority over coach suggestions.</p>
    <div class="coach-goals">{CALL_AREAS.map(area=><div class="coach-goal"><div><label for={`coverage-${area.id}`}>{area.label}</label><p>{area.goal}</p><small data-coverage-hint={area.id}></small></div><select id={`coverage-${area.id}`} data-coverage={area.id} aria-label={`${area.label} coverage`}>{Object.entries(COVERAGE_STATUSES).map(([status,label])=><option value={status}>{label}</option>)}</select></div>)}</div>
   </section>
   <section class="coach-panel coach-review" data-review hidden aria-labelledby="review-heading"><p class="eyebrow">Post-call review</p><h2 id="review-heading">Prepare the next conversation.</h2><p class="small">Based on your summaries. Verbal claims are unverified; risks are questions to investigate.</p><p class="small coach-freshness" data-review-freshness aria-live="polite" hidden></p><div class="coach-review-sections" data-review-sections></div><details class="coach-sources" data-review-sources-panel hidden><summary>Course concepts behind this review</summary><ul data-review-sources></ul></details></section>
  </div>
  <details class="coach-privacy" id="call-privacy"><summary>Privacy &amp; session notes</summary><p>Seller Call Coach does not record audio in this version. Use short summaries, not confidential transcripts. Do not enter confidential, proprietary, personal, or non-public deal information.</p><p>Notes stay in the active browser session, in page memory only. Reloading, leaving this page, or choosing Clear call clears notes and coaching. Notes, coverage and up to three recent coaching questions are sent to the AI service only when you request coaching or a review. Acquisition Companion does not intentionally persist notes or results as a deal file or conversation record, and this page does not send analytics.</p><p>AI requests use <code>store: false</code>. This is not a zero-retention guarantee: OpenAI and other service providers process requests under their own policies. No transcript or document uploads. <a href="/privacy/#ai-deal-lab">Privacy</a> · <a href="/terms/">Terms</a>.</p></details>
  <dialog data-clear-dialog aria-labelledby="clear-call-heading"><h2 id="clear-call-heading">Clear this call?</h2><p>Your notes, coverage and coaching will be removed from this page. This cannot be undone.</p><div class="coach-controls"><button type="button" class="button secondary" data-keep-call autofocus>Keep working</button><button type="button" class="button" data-confirm-clear>Clear notes and coaching</button></div></dialog>
 </div>
 <noscript><p class="notice">Seller Call Coach needs JavaScript. You can still read the <a href="/course/">free course</a>.</p></noscript>
 <script src="../../../scripts/call-coach.ts"></script>
</Base>
