---
import Base from '../layouts/Base.astro';import Crumbs from '../components/Crumbs.astro';import Filters from '../components/Filters.astro';import {numbers,videoById,label} from '../lib/data';
const categories=[...new Set(numbers.flatMap(n=>n.topics))].sort();const kinds=[...new Set(numbers.map(n=>n.kind))].sort();
---
<Base title="Acquisition numbers and rules of thumb" description="313 contextual references for valuation, leverage, equity, borrowing, fees and acquisition economics. Filter examples separately from targets and reported experience." type="Numbers" wide>
 <Crumbs items={[{title:'Numbers'}]} /><header class="page-header"><p class="eyebrow">The quantitative reference</p><h1>A number is only useful with its context.</h1><p>Browse 313 records drawn from the source collection. Each keeps its units, example type, original source, and material uncertainty. These are not current lending quotes or recommended underwriting assumptions.</p></header>
 <p class="notice warning">“Reported actual” means the source describes an event as having happened; it is not independent verification. Approximate, contradictory, and uncertain machine-transcribed figures remain qualified.</p>
 <Filters categories={categories} kinds={kinds} placeholder="Try ‘seller’, ‘EBITDA’, ‘covenant’, or ‘£33m’" label="Search numbers and context" />
 <p hidden data-empty-state class="empty-state">No matching records. Clear a filter or try a broader term.</p>
 <div class="table-scroll" tabindex="0" role="region" aria-label="Quantitative reference table"><table><caption>All values retain their source context. Open “Original sources” for further viewing.</caption><thead><tr><th scope="col">Value / evidence type</th><th scope="col">Meaning and limits</th><th scope="col">Reference</th></tr></thead><tbody>
 {numbers.map(n=><tr id={n.id} data-filter-item data-category={[n.category,...n.topics].join(' ')} data-kind={n.kind} data-search={`${n.metric} ${n.value} ${n.context} ${n.caution} ${n.topics.join(' ')}`}><td><span class="number-value">{n.value}</span><span class:list={['badge',n.confidence==='low'&&'caution']}>{n.confidence==='low'?'Uncertain source':label(n.kind)}</span></td><td class="number-context"><h2 style="font:650 .95rem var(--sans);letter-spacing:0;margin-bottom:.5rem">{n.metric}</h2><p>{n.context}</p>{n.caution && <span class="record-caution">{n.caution}</span>}<details class="record-sources" data-pagefind-ignore><summary>Original sources ({n.videoIds.length})</summary><ul>{n.videoIds.map(id=>{const v=videoById.get(id);return v&&<li><a href={v.url}>{v.title} — Watch the original →</a></li>;})}</ul></details></td><td><a class="record-anchor" href={`#${n.id}`} aria-label={`Permalink to ${n.metric}`}>{n.id}</a><ul class="chips spaced">{n.topics.slice(0,2).map(t=><li><a href={`/topics/${t}/`}>{label(t)}</a></li>)}</ul></td></tr>)}
 </tbody></table></div>
</Base>
