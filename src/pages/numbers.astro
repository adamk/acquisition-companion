---
import Base from '../layouts/Base.astro';import Crumbs from '../components/Crumbs.astro';import Filters from '../components/Filters.astro';import {numbers,fundNumbers,videoById,fundGuideById,label} from '../lib/data';
const categories=[...new Set([...numbers,...fundNumbers].flatMap(n=>n.topics))].sort();const kinds=[...new Set([...numbers,...fundNumbers].map(n=>n.kind))].sort();
---
<Base title="Quantitative Reference" description="Source-linked quantitative claims, examples, rules of thumb and reported figures. Inspect evidence and uncertainty; these are not current market benchmarks." type="Quantitative Reference" wide>
 <Crumbs items={[{title:'Sources',url:'/sources/'},{title:'Quantitative Reference'}]} /><header class="page-header"><p class="eyebrow">Evidence archive</p><h1>Quantitative Reference</h1><p>This source/reference database brings together quantitative claims, examples, rules of thumb and reported figures from the underlying materials: {numbers.length + fundNumbers.length} records, including {numbers.length} Yusufa-derived records and {fundNumbers.length} separately labeled Fund Launch references.</p><p class="spaced">Trace where a number came from, inspect its evidence type and context, compare conflicting claims, audit calculations and examples, and review uncertainty. These are not current market benchmarks, lender quotes, market consensus, recommended valuation ranges or debt terms, or verified transaction statistics. They are not recommended underwriting assumptions.</p></header>
 <p class="notice warning">“Reported actual” means the source describes an event as having happened; it is not independent verification. Approximate, contradictory, and uncertain machine-transcribed figures remain qualified.</p>
 <Filters categories={categories} kinds={kinds} placeholder="Try ‘seller’, ‘EBITDA’, ‘covenant’, or ‘£33m’" label="Search quantitative records and context" />
 <p hidden data-empty-state class="empty-state">No matching records. Clear a filter or try a broader term.</p>
 <div class="table-scroll" tabindex="0" role="region" aria-label="Quantitative reference table"><table><caption>All values retain their source context. Open “Original sources” for further viewing.</caption><thead><tr><th scope="col">Value / evidence type</th><th scope="col">Meaning and limits</th><th scope="col">Reference</th></tr></thead><tbody>
 {numbers.map(n=><tr id={n.id} data-filter-item data-category={[n.category,...n.topics].join(' ')} data-kind={n.kind} data-search={`${n.metric} ${n.value} ${n.context} ${n.caution} ${n.topics.join(' ')} Yusufa Sey`}><td><span class="number-value">{n.value}</span><span class:list={['badge',n.confidence==='low'&&'caution']}>{n.confidence==='low'?'Uncertain source':label(n.kind)}</span><span class="badge">Yusufa Sey</span></td><td class="number-context"><h2 style="font:650 .95rem var(--sans);letter-spacing:0;margin-bottom:.5rem">{n.metric}</h2><p>{n.context}</p>{n.caution && <span class="record-caution">{n.caution}</span>}<details class="record-sources" data-pagefind-ignore><summary>Original sources ({n.videoIds.length})</summary><ul>{n.videoIds.map(id=>{const v=videoById.get(id);return v&&<li><a href={v.url} data-source-title={v.title}>{v.title} — Watch the original →</a></li>;})}</ul></details></td><td><a class="record-anchor" href={`#${n.id}`} aria-label={`Permalink to ${n.metric}`}>{n.id}</a><ul class="chips spaced">{n.topics.slice(0,2).map(t=><li><a href={`/topics/${t}/`}>{label(t)}</a></li>)}</ul></td></tr>)}
 {fundNumbers.map(n=>{const g=fundGuideById.get(n.sourceId);return <tr id={n.id} data-filter-item data-category={n.topics.join(' ')} data-kind={n.kind} data-search={`${n.metric} ${n.value} ${n.context} ${n.caution} ${n.topics.join(' ')} Fund Launch`}><td><span class="number-value">{n.value}</span><span class="badge">{label(n.kind)}</span><span class="badge">Fund Launch</span></td><td class="number-context"><h2 style="font:650 .95rem var(--sans);letter-spacing:0;margin-bottom:.5rem">{n.metric}</h2><p>{n.context}</p><span class="record-caution">{n.caution}</span><details class="record-sources" data-pagefind-ignore><summary>Original source</summary><ul><li><a href={g?.url}>Fund Launch — {g?.title} · Read original →</a></li></ul></details></td><td><a class="record-anchor" href={`#${n.id}`} aria-label={`Permalink to ${n.metric}`}>{n.id}</a><ul class="chips spaced">{n.topics.map(t=><li><a href={`/topics/${t}/`}>{label(t)}</a></li>)}</ul></td></tr>})}
 </tbody></table></div>
</Base>
