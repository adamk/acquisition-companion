---
import {getCollection} from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Crumbs from '../../../components/Crumbs.astro';
import {fundGuides} from '../../../lib/data';
export function getStaticPaths(){return fundGuides.map(guide=>({params:{id:guide.id},props:{guide}}));}
const {guide:g}=Astro.props;
const lessons=(await getCollection('lessons')).filter(x=>x.data.fundSources.includes(g.id));
const topics=(await getCollection('topics')).filter(x=>x.data.fundSources.includes(g.id));
---
<Base title={g.title} description={g.summary} type="Source guide"><Crumbs items={[{title:'Sources',url:'/sources/'},{title:'Fund Launch',url:'/sources/fund-launch/'},{title:'Guide notes'}]}/><article class="narrow"><header class="page-header"><p class="eyebrow">Public educational guide · {g.organization}</p><h1>{g.title}</h1><p>{g.summary}</p></header><div class="source-callout"><p>Read the original guide for Fund Launch’s full explanation, current wording and context. These notes select only concepts relevant to buying and financing businesses.</p><a class="button" href={g.url}>Read original →</a></div><section class="section"><h2>What this guide adds</h2><ul class="content-list spaced">{g.notes.map(n=><li><p>{n.statement}</p></li>)}</ul></section>{topics.length>0 && <section class="section"><h2>Connected concepts</h2><ul class="chips spaced">{topics.map(t=><li><a href={`/topics/${t.id}/`}>{t.data.title}</a></li>)}</ul></section>}{lessons.length>0 && <section class="section"><h2>Used in the course</h2><ul class="content-list spaced">{lessons.map(l=><li><h3><a href={`/course/${l.id}/`}>{l.data.title}</a></h3><p>{l.data.description}</p></li>)}</ul></section>}<p class="coverage-note spaced">These notes are original synthesis and comparisons, not a reproduction of the guide. Securities and fund structures depend on jurisdiction and facts; seek professional legal, tax and compliance advice for a real transaction.</p></article></Base>
