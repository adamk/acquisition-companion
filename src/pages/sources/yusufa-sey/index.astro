---
import Base from '../../../layouts/Base.astro';import Crumbs from '../../../components/Crumbs.astro';import Filters from '../../../components/Filters.astro';import {videos,videoPath,label} from '../../../lib/data';import {siteConfig} from '../../../site-config.mjs';
const topics=[...new Set(videos.flatMap(v=>v.topics))].sort();const collection=siteConfig.collections['yusufa-sey'];
---
<Base title={`${collection.name}: source collection`} description="All 117 source videos and Shorts, linked to their original YouTube pages and related acquisition lessons." type="Source index">
 <Crumbs items={[{title:'Sources',url:'/sources/'},{title:collection.name}]}/><header class="page-header"><p class="eyebrow">Source collection 01</p><h1>{collection.name}</h1><p>117 original videos and Shorts. Browse the concepts that informed this guide, then watch the source for the full context. No transcript text is published here.</p></header><Filters categories={topics} kinds={['financing','acquisitions','limited']} placeholder="Search titles or concepts" label="Find an original video" /><p hidden data-empty-state class="empty-state">No matching videos. Clear a filter or try a broader concept.</p><ul class="content-list">{videos.map(v=><li data-filter-item data-search={`${v.title} ${v.summary} ${v.topics.join(' ')}`} data-category={v.topics.join(' ')} data-kind={v.usefulDebt?'financing':v.usefulPE?'acquisitions':'limited'}><span class:list={['badge',v.limited&&'caution']}>{v.limited?'Limited usable evidence':v.usefulDebt?'Financing discussed':'Acquisition collection'}</span><h2 class="spaced"><a href={videoPath(v.id)}>{v.title}</a></h2><p>{v.summary}</p><div class="source-actions"><a href={v.url}>Watch original on YouTube →</a><a href={videoPath(v.id)}>Concepts &amp; source notes</a></div><ul class="chips spaced">{v.topics.slice(0,4).map(t=><li><a href={`/topics/${t}/`}>{label(t)}</a></li>)}</ul></li>)}</ul>
</Base>
