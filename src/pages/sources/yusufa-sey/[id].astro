---
import {getCollection} from 'astro:content';import Base from '../../../layouts/Base.astro';import Crumbs from '../../../components/Crumbs.astro';import {videos} from '../../../lib/data';import {siteConfig} from '../../../site-config.mjs';
export function getStaticPaths(){return videos.map(video=>({params:{id:video.id},props:{video}}));}
const {video:v}=Astro.props;const lessons=(await getCollection('lessons')).filter(x=>x.data.sources.includes(v.id));const topics=(await getCollection('topics')).filter(x=>v.topics.includes(x.id));
---
<Base title={v.title} description={v.summary} type="Source video"><Crumbs items={[{title:'Sources',url:'/sources/'},{title:siteConfig.collections['yusufa-sey'].name,url:'/sources/yusufa-sey/'},{title:'Video notes'}]}/><article class="narrow"><header class="page-header"><p class="eyebrow">Original source · {siteConfig.collections['yusufa-sey'].name}</p><h1 style="max-width:26ch;font-size:clamp(2rem,4vw,3rem)">{v.title}</h1><p>{v.summary}</p></header><div class="source-callout"><p>This page connects the source to the guide. Watch the original for the creator’s explanation and full context.</p><a class="button" href={v.url} data-source-title={v.title}>Watch original on YouTube →</a></div>{v.transcript && <section class="section" aria-labelledby="transcript-provenance"><h2 id="transcript-provenance">Source and transcript provenance</h2><p>{v.creator}{v.publishedAt && <> · Published <time datetime={v.publishedAt}>{v.publishedAt}</time></>}</p><p class="coverage-note spaced">{v.transcript.caution}</p><h3 class="spaced">Reviewed context</h3><p class="small muted">Ranges refer to the supplied machine-generated SRT transcript; timing and wording may be imperfect. These are editorial context notes, not a transcript.</p><ul class="content-list spaced">{v.transcript.sections.map(section=><li id={section.id}><h3>{section.range} · {section.classification}</h3><p>{section.note}</p></li>)}</ul></section>}{v.limited && <p class="notice warning">This item has limited usable educational evidence. Its presence in the inventory does not establish claims suggested by the title.</p>}{topics.length>0 && <section class="section"><h2>Concepts connected to this source</h2><ul class="chips spaced">{topics.map(t=><li><a href={`/topics/${t.id}/`}>{t.data.title}</a></li>)}</ul></section>}{lessons.length>0 && <section class="section"><h2>Used in the course</h2><ul class="content-list spaced">{lessons.map(l=><li><h3><a href={`/course/${l.id}/`}>{l.data.title}</a></h3><p>{l.data.description}</p></li>)}</ul></section>}<p class="coverage-note spaced">The site’s notes are original editorial synthesis. Source statements may describe opinions, illustrations, proposals, or personal experience. The research used machine-generated text, so material uncertainties remain qualified. <a href="/methodology/">How sources are handled.</a></p></article></Base>
