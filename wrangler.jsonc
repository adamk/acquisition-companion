{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acquisition-companion",
  "main": "src/worker/paid-production-index.mjs",
  "compatibility_date": "2026-09-30",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "vars": {
    "PAID_ENVIRONMENT": "production",
    "BILLING_TEST_MODE": "false",
    "ACCOUNT_ORIGIN": "https://acquisitioncompanion.com",
    "AI_PAYWALL_ENABLED": "false",
    "AUTH_SIGNIN_ENABLED": "false",
    "BILLING_ENABLED": "false",
    "AI_ALLOW_TRIALS": "false",
    "AI_MONTHLY_REQUEST_LIMIT": "100",
    "PAID_DIAGNOSTICS_ENABLED": "true",
    "AUTH_MAIL_ENABLED": "false",
    "STRIPE_MONTHLY_PRICE_ID": "price_1UMbSIKGOtHP6zWlL79BlVMm",
    "STRIPE_ANNUAL_PRICE_ID": "price_1UMbSJKGOtHP6zWlHxMkn1PR",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1UMbSKKGOtHP6zWl8VVjqsdd"
  },
  "d1_databases": [
    {
      "binding": "PAID_DB",
      "database_name": "acquisition-companion-paid-production",
      "database_id": "fd456ea3-644c-4867-8089-5197378de990",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "AUTH_MAILER",
      "service": "acquisition-companion-mailer-production",
      "entrypoint": "AuthMailer"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_SESSION_LIMITER",
      "namespace_id": "2827600191301",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "AI_IP_LIMITER",
      "namespace_id": "2827600191302",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "AI_EDGE_LIMITER",
      "namespace_id": "2827600191303",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
